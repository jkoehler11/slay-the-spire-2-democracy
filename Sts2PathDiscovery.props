<Project>
    <!-- Auto-discovers STS2 install paths. From Alchyr/ModTemplate-StS2 template. -->
    <PropertyGroup>
        <Sts2AppId>2868840</Sts2AppId>
    </PropertyGroup>

    <!-- Steam default locations per platform -->
    <PropertyGroup Condition="'$(Sts2Path)' == ''">
        <Sts2Path Condition="'$(OS)' == 'Windows_NT'">C:/Program Files (x86)/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2Path Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(HOME)/.steam/steam/steamapps/common/Slay the Spire 2</Sts2Path>
        <Sts2Path Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(HOME)/Library/Application Support/Steam/steamapps/common/Slay the Spire 2</Sts2Path>
    </PropertyGroup>

    <PropertyGroup>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
        <Sts2DataDir Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <ModsPath Condition="$([MSBuild]::IsOSPlatform('OSX'))">SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
    </PropertyGroup>
</Project>
